<UserControl x:Class="WindowsDynamicIsland.UI.Views.ExpandedTimerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:WindowsDynamicIsland.UI.Components"
             xmlns:audio="clr-namespace:WindowsDynamicIsland.Audio"
             xmlns:m="clr-namespace:WindowsDynamicIsland.Core.Models"
             xmlns:ui="clr-namespace:WindowsDynamicIsland.UI">
    <Grid Margin="{StaticResource ExpandedPadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Width="40" Height="40" VerticalAlignment="Center">
                <c:ProgressRing Value="{Binding TimerFraction}"
                                RingThickness="3.5"
                                FillBrush="{StaticResource AccentOrangeBrush}"
                                TrackBrush="{StaticResource AccentOrangeSoftBrush}"
                                Visibility="{Binding IsCountdown, Converter={StaticResource BoolToVisibility}}" />
                <Ellipse Fill="{StaticResource AccentOrangeSoftBrush}"
                         Visibility="{Binding IsCountdown, Converter={StaticResource InverseBoolToVisibility}}" />
                <TextBlock Style="{StaticResource GlyphText}"
                           FontSize="{StaticResource IconSize}"
                           Foreground="{StaticResource AccentOrangeBrush}"
                           Text="{x:Static m:Glyphs.Stopwatch}" />
            </Grid>

            <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource CaptionText}" Text="{Binding TimerCaption}" />
                <TextBlock Style="{StaticResource DigitsText}" Foreground="{StaticResource AccentOrangeBrush}"
                           Text="{Binding TimerText}" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource FilledIconButtonStyle}"
                        Background="{StaticResource AccentOrangeSoftBrush}"
                        Foreground="{StaticResource AccentOrangeBrush}"
                        Content="{Binding TimerToggleGlyph}"
                        Command="{Binding TimerToggleCommand}"
                        ToolTip="Пауза / продолжить" />
                <Button Margin="10,0,0,0"
                        Style="{StaticResource FilledIconButtonStyle}"
                        Content="{x:Static m:Glyphs.Close}"
                        FontSize="{StaticResource IconSizeSmall}"
                        Command="{Binding TimerStopCommand}"
                        ToolTip="Остановить" />
            </StackPanel>
        </Grid>

        <!-- Countdown only: remaining bar + "+1 мин". -->
        <Grid Grid.Row="1" Margin="0,12,0,0"
              Visibility="{Binding IsCountdown, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <c:LevelBar Height="4" VerticalAlignment="Center"
                        Value="{Binding TimerFraction}"
                        BarThickness="4"
                        FillBrush="{StaticResource AccentOrangeBrush}"
                        TrackBrush="{StaticResource AccentOrangeSoftBrush}" />
            <Button Grid.Column="1" Margin="12,0,0,0"
                    Style="{StaticResource ChipButtonStyle}"
                    Content="+1 мин"
                    Command="{Binding TimerAddMinuteCommand}" />
        </Grid>
    </Grid>
</UserControl>

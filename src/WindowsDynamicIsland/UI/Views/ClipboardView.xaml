<UserControl x:Class="WindowsDynamicIsland.UI.Views.ClipboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="clr-namespace:WindowsDynamicIsland.Core.Models">
    <UserControl.Resources>
        <!-- Whole row is one button: click = paste into the app you are typing in. -->
        <Style x:Key="ClipboardRowStyle" TargetType="{x:Type Button}">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd" Background="{StaticResource ChipBrush}" CornerRadius="12" Padding="10,0,4,0">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#26FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RowIconButton" TargetType="{x:Type Button}" BasedOn="{StaticResource IconButtonStyle}">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="{StaticResource ExpandedPadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource GlyphText}" FontSize="{StaticResource IconSize}" VerticalAlignment="Center"
                       Foreground="{StaticResource TextPrimaryBrush}" Text="{x:Static m:Glyphs.Copy}" />
            <StackPanel Grid.Column="1" Margin="10,0,8,0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource TitleText}" Text="Буфер обмена" />
                <TextBlock Margin="10,1,0,0" VerticalAlignment="Center" Style="{StaticResource CaptionText}"
                           Foreground="{StaticResource AccentGreenBrush}" Text="{Binding ClipboardStatus}" />
            </StackPanel>
            <Button Grid.Column="2" Style="{StaticResource ChipButtonStyle}" Content="Все записи"
                    ToolTip="Открыть окно с поиском" Command="{Binding OpenClipboardHistoryCommand}" />
        </Grid>

        <!-- Items: scroll with the mouse wheel -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
                      Focusable="False" PanningMode="VerticalOnly">
            <ItemsControl x:Name="List" ItemsSource="{Binding ClipboardEntries}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type m:ClipboardEntry}">
                        <Button Style="{StaticResource ClipboardRowStyle}"
                                ToolTip="Вставить"
                                Command="{Binding DataContext.PasteClipboardCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                CommandParameter="{Binding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="KindIcon" Style="{StaticResource GlyphText}" FontSize="13" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding KindGlyph}" />
                                <Border x:Name="Thumb" Width="26" Height="26" CornerRadius="5" Visibility="Collapsed"
                                        HorizontalAlignment="Left" ClipToBounds="True">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding Image}" Stretch="UniformToFill" />
                                    </Border.Background>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="6,0,6,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource LabelText}" FontWeight="Normal" Text="{Binding ShortPreview}" />
                                    <TextBlock Style="{StaticResource TertiaryCaptionText}" Text="{Binding Meta}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="PinButton" Style="{StaticResource RowIconButton}" Content="{Binding PinGlyph}" ToolTip="Закрепить"
                                            Command="{Binding DataContext.PinClipboardCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                            CommandParameter="{Binding}" />
                                    <Button Style="{StaticResource RowIconButton}" Content="{x:Static m:Glyphs.Copy}" ToolTip="Только скопировать"
                                            Command="{Binding DataContext.CopyClipboardCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                            CommandParameter="{Binding}" />
                                    <Button Style="{StaticResource RowIconButton}" Content="{x:Static m:Glyphs.Delete}" ToolTip="Удалить"
                                            Command="{Binding DataContext.DeleteClipboardCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </Grid>
                        </Button>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsImage}" Value="True">
                                <Setter TargetName="KindIcon" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="Thumb" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                <Setter TargetName="PinButton" Property="Foreground" Value="{StaticResource AccentBlueBrush}" />
                                <Setter TargetName="PinButton" Property="ToolTip" Value="Открепить" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource CaptionText}"
                   FontSize="13" Text="Скопируй что-нибудь — оно появится здесь"
                   Visibility="{Binding HasItems, ElementName=List, Converter={StaticResource InverseBoolToVisibility}}" />
    </Grid>
</UserControl>

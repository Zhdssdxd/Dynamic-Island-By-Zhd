<UserControl x:Class="WindowsDynamicIsland.UI.Views.NotificationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:WindowsDynamicIsland.UI.Components"
             xmlns:audio="clr-namespace:WindowsDynamicIsland.Audio"
             xmlns:m="clr-namespace:WindowsDynamicIsland.Core.Models"
             xmlns:ui="clr-namespace:WindowsDynamicIsland.UI">
    <!-- Metrics must stay in sync with IslandLayout.Notification* constants (padding 16/13, icon 36, gap 12). -->
    <Grid Margin="16,13,16,13">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="36" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <c:ArtworkImage Width="36" Height="36"
                        VerticalAlignment="Center"
                        CornerRadius="9"
                        FallbackCornerRadius="18"
                        Source="{Binding NotificationIcon}"
                        FallbackGlyph="{Binding NotificationGlyph}"
                        GlyphSize="16" />

        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
            <Grid Height="17">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Style="{StaticResource CaptionText}" Text="{Binding NotificationAppName}" />
                <TextBlock Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"
                           Style="{StaticResource TertiaryCaptionText}" Text="{Binding NotificationTimeText}" />
                <Border Grid.Column="2" Margin="6,0,0,0" Height="15" Padding="5,0" VerticalAlignment="Center"
                        CornerRadius="7.5" Background="{StaticResource ChipBrush}"
                        Visibility="{Binding PendingBadgeText, Converter={StaticResource HasValueToVisibility}}">
                    <TextBlock VerticalAlignment="Center" FontSize="10" FontWeight="SemiBold"
                               Style="{StaticResource CaptionText}" Foreground="{StaticResource TextPrimaryBrush}"
                               Text="{Binding PendingBadgeText}" />
                </Border>
            </Grid>
            <TextBlock Height="19" Style="{StaticResource SubtitleText}" Text="{Binding NotificationTitle}"
                       Visibility="{Binding NotificationTitle, Converter={StaticResource HasValueToVisibility}}" />
            <TextBlock Style="{StaticResource BodyText}"
                       TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis"
                       LineHeight="17"
                       LineStackingStrategy="BlockLineHeight"
                       MaxHeight="34"
                       Text="{Binding NotificationBody}"
                       Visibility="{Binding NotificationBody, Converter={StaticResource HasValueToVisibility}}" />
        </StackPanel>
    </Grid>
</UserControl>

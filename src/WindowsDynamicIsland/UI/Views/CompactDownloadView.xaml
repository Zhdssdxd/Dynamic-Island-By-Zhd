<UserControl x:Class="WindowsDynamicIsland.UI.Views.CompactDownloadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:WindowsDynamicIsland.UI.Components"
             xmlns:audio="clr-namespace:WindowsDynamicIsland.Audio"
             xmlns:m="clr-namespace:WindowsDynamicIsland.Core.Models"
             xmlns:ui="clr-namespace:WindowsDynamicIsland.UI">
    <Grid Margin="{StaticResource CompactPadding}" VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Grid Width="20" Height="20" VerticalAlignment="Center">
            <c:ProgressRing Value="{Binding DownloadFraction}"
                            RingThickness="2.5"
                            FillBrush="{Binding DownloadBrush}"
                            TrackBrush="{StaticResource TrackBrush}"
                            Visibility="{Binding ShowDownloadRing, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Style="{StaticResource GlyphText}"
                       FontSize="{StaticResource IconSizeSmall}"
                       Foreground="{Binding DownloadBrush}"
                       Text="{Binding DownloadGlyph}"
                       Visibility="{Binding ShowDownloadRing, Converter={StaticResource InverseBoolToVisibility}}" />
        </Grid>

        <TextBlock Grid.Column="2"
                   Margin="0,0,10,0"
                   Style="{StaticResource GlyphText}"
                   FontSize="{StaticResource IconSizeSmall}"
                   Text="{Binding SecondaryActivityGlyph}"
                   Foreground="{Binding SecondaryActivityBrush}"
                   Visibility="{Binding HasSecondaryActivity, Converter={StaticResource BoolToVisibility}}" />

        <TextBlock Grid.Column="3"
                   VerticalAlignment="Center"
                   Style="{StaticResource CompactDigitsText}"
                   FontSize="{StaticResource FontSizeBody}"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   Text="{Binding DownloadCompactText}" />
    </Grid>
</UserControl>

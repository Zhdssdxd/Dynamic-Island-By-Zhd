<UserControl x:Class="WindowsDynamicIsland.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:WindowsDynamicIsland.UI.Components"
             xmlns:audio="clr-namespace:WindowsDynamicIsland.Audio"
             xmlns:m="clr-namespace:WindowsDynamicIsland.Core.Models"
             xmlns:ui="clr-namespace:WindowsDynamicIsland.UI">
    <Grid Margin="{StaticResource ExpandedPadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Clock + date, quick actions on the right. -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Style="{StaticResource DigitsText}" Text="{Binding ClockText}" />
                <TextBlock Margin="1,-2,0,0" Style="{StaticResource CaptionText}" Text="{Binding DateText}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource FilledIconButtonStyle}"
                        Background="{StaticResource AccentOrangeSoftBrush}"
                        Foreground="{StaticResource AccentOrangeBrush}"
                        Content="{x:Static m:Glyphs.Stopwatch}"
                        Command="{Binding StartStopwatchCommand}"
                        ToolTip="Секундомер" />
                <Button Margin="10,0,0,0"
                        Style="{StaticResource FilledIconButtonStyle}"
                        Content="{x:Static m:Glyphs.Settings}"
                        Command="{Binding OpenSettingsCommand}"
                        ToolTip="Настройки" />
            </StackPanel>
        </Grid>

        <!-- Timer presets. -->
        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <TextBlock Margin="0,0,10,0" VerticalAlignment="Center" Style="{StaticResource CaptionText}" Text="Таймер, мин" />
            <ItemsControl ItemsSource="{Binding TimerPresets}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type ui:TimerPreset}">
                        <Button Margin="0,0,6,0"
                                Style="{StaticResource ChipButtonStyle}"
                                Content="{Binding Label}"
                                Command="{Binding DataContext.StartTimerCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                CommandParameter="{Binding Minutes}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Grid>
</UserControl>

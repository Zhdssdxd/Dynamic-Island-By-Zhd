<UserControl x:Class="WindowsDynamicIsland.UI.Views.ExpandedDownloadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:WindowsDynamicIsland.UI.Components"
             xmlns:audio="clr-namespace:WindowsDynamicIsland.Audio"
             xmlns:m="clr-namespace:WindowsDynamicIsland.Core.Models"
             xmlns:ui="clr-namespace:WindowsDynamicIsland.UI">
    <Grid Margin="{StaticResource ExpandedPadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="38" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Width="36" Height="36" HorizontalAlignment="Left">
                <Ellipse Fill="{StaticResource SurfaceElevatedBrush}" />
                <TextBlock Style="{StaticResource GlyphText}" Foreground="{Binding DownloadBrush}" Text="{Binding DownloadGlyph}" />
            </Grid>
            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource SubtitleText}" TextTrimming="CharacterEllipsis" Text="{Binding DownloadFileName}" />
                <TextBlock Margin="0,1,0,0" Style="{StaticResource CaptionText}" Text="{Binding DownloadStatusText}" />
            </StackPanel>
        </Grid>

        <!-- Determinate bar when the size is known (or finished), shimmer otherwise. -->
        <Grid Grid.Row="1" Margin="0,10,0,0" Height="4">
            <c:LevelBar BarThickness="4"
                        Value="{Binding DownloadFraction}"
                        FillBrush="{Binding DownloadBrush}"
                        TrackBrush="{StaticResource TrackBrush}"
                        Visibility="{Binding IsDownloadDeterminate, Converter={StaticResource BoolToVisibility}}" />
            <c:ShimmerBar BarThickness="4"
                          FillBrush="{Binding DownloadBrush}"
                          TrackBrush="{StaticResource TrackBrush}"
                          Visibility="{Binding IsDownloadDeterminate, Converter={StaticResource InverseBoolToVisibility}}" />
        </Grid>

        <Grid Grid.Row="2" Margin="0,5,0,0">
            <TextBlock Style="{StaticResource TabularCaptionText}" Text="{Binding DownloadSizeText}" />
            <TextBlock HorizontalAlignment="Right" Style="{StaticResource TabularCaptionText}" Text="{Binding DownloadSpeedText}" />
        </Grid>
    </Grid>
</UserControl>

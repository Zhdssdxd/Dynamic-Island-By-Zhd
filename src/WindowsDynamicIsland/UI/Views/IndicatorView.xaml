<UserControl x:Class="WindowsDynamicIsland.UI.Views.IndicatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:WindowsDynamicIsland.UI.Components"
             xmlns:audio="clr-namespace:WindowsDynamicIsland.Audio"
             xmlns:m="clr-namespace:WindowsDynamicIsland.Core.Models"
             xmlns:ui="clr-namespace:WindowsDynamicIsland.UI">
    <Grid Margin="14,0,16,0" VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Style="{StaticResource GlyphText}"
                   HorizontalAlignment="Left"
                   Foreground="{Binding IndicatorBrush}"
                   Text="{Binding IndicatorGlyph}" />

        <TextBlock Grid.Column="1" Margin="4,0,10,0" VerticalAlignment="Center"
                   Style="{StaticResource LabelText}" Text="{Binding IndicatorTitle}" />

        <!-- Level bar updates in place (dragging the volume slider animates smoothly). -->
        <c:LevelBar Grid.Column="2" Width="72" Height="5" VerticalAlignment="Center"
                    BarThickness="5"
                    Value="{Binding IndicatorLevel}"
                    FillBrush="{Binding IndicatorBrush}"
                    TrackBrush="{StaticResource TrackBrush}"
                    Opacity="{Binding IndicatorBarOpacity}"
                    Visibility="{Binding HasIndicatorLevel, Converter={StaticResource BoolToVisibility}}" />

        <TextBlock Grid.Column="3" Margin="10,0,0,0" MinWidth="30" VerticalAlignment="Center" TextAlignment="Right"
                   Style="{StaticResource TabularCaptionText}" Foreground="{StaticResource TextPrimaryBrush}"
                   Text="{Binding IndicatorValueText}"
                   Visibility="{Binding IndicatorValueText, Converter={StaticResource HasValueToVisibility}}" />
    </Grid>
</UserControl>

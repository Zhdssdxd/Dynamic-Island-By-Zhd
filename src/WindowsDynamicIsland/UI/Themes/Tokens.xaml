<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!--
        DESIGN TOKENS — single source of truth for colors, type and spacing.
        Owned by the Orchestrator. Agents consume these keys (StaticResource / DynamicResource);
        new tokens are requested through the orchestrator, not added ad hoc in feature files.
    -->

    <!-- ───────── Colors ───────── -->
    <Color x:Key="IslandColor">#FF000000</Color>
    <Color x:Key="GraphiteColor">#FF0E0E10</Color>
    <Color x:Key="SurfaceColor">#FF1C1C1E</Color>
    <Color x:Key="SurfaceElevatedColor">#FF2C2C2E</Color>
    <Color x:Key="SurfaceHoverColor">#FF3A3A3C</Color>
    <Color x:Key="TextPrimaryColor">#FFFFFFFF</Color>
    <Color x:Key="TextSecondaryColor">#FF98989F</Color>
    <Color x:Key="TextTertiaryColor">#FF636366</Color>
    <Color x:Key="StrokeColor">#1FFFFFFF</Color>
    <Color x:Key="SeparatorColor">#26FFFFFF</Color>
    <Color x:Key="AccentGreenColor">#FF30D158</Color>
    <Color x:Key="AccentOrangeColor">#FFFF9F0A</Color>
    <Color x:Key="AccentRedColor">#FFFF453A</Color>
    <Color x:Key="AccentBlueColor">#FF0A84FF</Color>
    <Color x:Key="AccentYellowColor">#FFFFD60A</Color>
    <Color x:Key="ShadowColor">#FF000000</Color>

    <SolidColorBrush x:Key="IslandBrush" Color="{StaticResource IslandColor}" />
    <SolidColorBrush x:Key="GraphiteBrush" Color="{StaticResource GraphiteColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="{StaticResource SurfaceElevatedColor}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}" />
    <SolidColorBrush x:Key="StrokeBrush" Color="{StaticResource StrokeColor}" />
    <SolidColorBrush x:Key="SeparatorBrush" Color="{StaticResource SeparatorColor}" />
    <SolidColorBrush x:Key="AccentGreenBrush" Color="{StaticResource AccentGreenColor}" />
    <SolidColorBrush x:Key="AccentOrangeBrush" Color="{StaticResource AccentOrangeColor}" />
    <SolidColorBrush x:Key="AccentRedBrush" Color="{StaticResource AccentRedColor}" />
    <SolidColorBrush x:Key="AccentBlueBrush" Color="{StaticResource AccentBlueColor}" />
    <SolidColorBrush x:Key="AccentYellowBrush" Color="{StaticResource AccentYellowColor}" />
    <SolidColorBrush x:Key="TrackBrush" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="FillBrush" Color="#FFFFFFFF" />

    <!-- ───────── Typography ───────── -->
    <!-- Segoe UI Variable exists on Windows 11; Windows 10 falls back to Segoe UI. -->
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <!-- Fluent Icons on Windows 11, MDL2 Assets on Windows 10 (same code points, see Core/Models/Glyphs.cs). -->
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <sys:Double x:Key="FontSizeCaption">11</sys:Double>
    <sys:Double x:Key="FontSizeBody">13</sys:Double>
    <sys:Double x:Key="FontSizeSubtitle">14</sys:Double>
    <sys:Double x:Key="FontSizeTitle">15</sys:Double>
    <sys:Double x:Key="FontSizeLarge">20</sys:Double>
    <sys:Double x:Key="FontSizeDigits">30</sys:Double>
    <sys:Double x:Key="IconSizeSmall">13</sys:Double>
    <sys:Double x:Key="IconSize">16</sys:Double>
    <sys:Double x:Key="IconSizeLarge">22</sys:Double>

    <!-- ───────── Spacing / radii ───────── -->
    <sys:Double x:Key="SpacingXS">4</sys:Double>
    <sys:Double x:Key="SpacingS">8</sys:Double>
    <sys:Double x:Key="SpacingM">12</sys:Double>
    <sys:Double x:Key="SpacingL">16</sys:Double>
    <sys:Double x:Key="SpacingXL">20</sys:Double>
    <Thickness x:Key="CompactPadding">10,0,10,0</Thickness>
    <Thickness x:Key="ExpandedPadding">18,14,18,14</Thickness>
    <CornerRadius x:Key="RadiusSmall">6</CornerRadius>
    <CornerRadius x:Key="RadiusMedium">10</CornerRadius>
    <CornerRadius x:Key="RadiusLarge">14</CornerRadius>
    <CornerRadius x:Key="ArtworkRadiusCompact">6</CornerRadius>
    <CornerRadius x:Key="ArtworkRadiusExpanded">12</CornerRadius>

    <!-- ───────── Island geometry (DIPs) — defaults; compact size comes from settings ───────── -->
    <sys:Double x:Key="IslandHostWidth">560</sys:Double>
    <sys:Double x:Key="IslandHostHeight">280</sys:Double>
</ResourceDictionary>

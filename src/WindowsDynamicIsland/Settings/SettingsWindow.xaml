<Window x:Class="WindowsDynamicIsland.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dynamic Island — Настройки"
        Width="860"
        Height="600"
        MinWidth="720"
        MinHeight="460"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        ResizeMode="CanResize"
        Icon="pack://application:,,,/DynamicIsland;component/Assets/island.ico"
        Background="#FF202020"
        Foreground="White"
        Language="ru-RU"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/DynamicIsland;component/Settings/SettingsStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ═══════════════ Navigation ═══════════════ -->
        <DockPanel Grid.Column="0" Margin="12,18,6,14">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="12,0,0,20">
                <Border Width="38" Height="16" CornerRadius="8" Background="Black"
                        BorderBrush="{StaticResource SettingsControlBorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                    <Ellipse Width="5" Height="5" Fill="{StaticResource AccentGreenBrush}" HorizontalAlignment="Right" Margin="0,0,6,0" />
                </Border>
                <TextBlock Text="Dynamic Island" Margin="12,0,0,0" VerticalAlignment="Center"
                           FontFamily="{StaticResource DisplayFont}" FontSize="{StaticResource FontSizeTitle}"
                           FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
            </StackPanel>

            <TextBlock DockPanel.Dock="Bottom" Margin="14,8,0,0" Style="{StaticResource SettingsCaptionText}">
                <Run Text="Версия " /><Run Text="{Binding AppVersion, Mode=OneWay}" />
            </TextBlock>

            <ListBox x:Name="NavList"
                     Style="{StaticResource NavListBox}"
                     ItemContainerStyle="{StaticResource NavListBoxItem}"
                     SelectionChanged="NavList_SelectionChanged">
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource SettingsIconText}" Text="&#xE790;" />
                        <TextBlock Text="Внешний вид" Margin="14,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource SettingsIconText}" Text="&#xE8D6;" />
                        <TextBlock Text="Функции" Margin="14,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource SettingsIconText}" Text="&#xE767;" />
                        <TextBlock Text="Индикаторы" Margin="14,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource SettingsIconText}" Text="&#xE916;" />
                        <TextBlock Text="Таймер" Margin="14,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource SettingsIconText}" Text="&#xE770;" />
                        <TextBlock Text="Система" Margin="14,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource SettingsIconText}" Text="&#xE9D9;" />
                        <TextBlock Text="Диагностика" Margin="14,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource SettingsIconText}" Text="&#xE946;" />
                        <TextBlock Text="О программе" Margin="14,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
            </ListBox>
        </DockPanel>

        <!-- ═══════════════ Pages ═══════════════ -->
        <Grid Grid.Column="1">

            <!-- ─────────── Внешний вид ─────────── -->
            <ScrollViewer x:Name="PageAppearance" VerticalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel Margin="24,20,28,28">
                    <TextBlock Style="{StaticResource SettingsPageTitle}" Text="Внешний вид" />

                    <!-- Live preview -->
                    <Border Style="{StaticResource SettingsCard}" Padding="12">
                        <Border Height="130" CornerRadius="6" ClipToBounds="True">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FF3A4A6B" Offset="0" />
                                    <GradientStop Color="#FF24324A" Offset="0.55" />
                                    <GradientStop Color="#FF1A2133" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <Border VerticalAlignment="Top"
                                        HorizontalAlignment="{Binding PreviewAlignment}"
                                        Margin="{Binding PreviewMargin}"
                                        Width="{Binding CompactWidth}"
                                        Height="{Binding CompactHeight}"
                                        CornerRadius="{Binding PreviewCornerRadius}"
                                        Background="{Binding PreviewBrush}"
                                        BorderBrush="#14FFFFFF"
                                        BorderThickness="1">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.5" Color="{StaticResource ShadowColor}" />
                                    </Border.Effect>
                                    <Grid Margin="10,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="16" Height="16" CornerRadius="4" VerticalAlignment="Center">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#FFFF9F0A" Offset="0" />
                                                    <GradientStop Color="#FFFF375F" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Rectangle Width="3" Height="8" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource AccentGreenBrush}" Margin="1,0" VerticalAlignment="Center" />
                                            <Rectangle Width="3" Height="13" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource AccentGreenBrush}" Margin="1,0" VerticalAlignment="Center" />
                                            <Rectangle Width="3" Height="6" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource AccentGreenBrush}" Margin="1,0" VerticalAlignment="Center" />
                                            <Rectangle Width="3" Height="11" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource AccentGreenBrush}" Margin="1,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,14,12"
                                        Width="120" Height="48" Background="#F2000000"
                                        CornerRadius="{Binding PreviewExpandedCornerRadius}">
                                    <TextBlock Text="Развёрнутый" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Предпросмотр" Foreground="#99FFFFFF" FontSize="11" Margin="12,0,0,10"
                                           HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                            </Grid>
                        </Border>
                    </Border>

                    <TextBlock Style="{StaticResource SettingsSectionHeader}" Text="Капсула" />
                    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Ширина" Tag="Ширина свёрнутой капсулы">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource SettingsValueText}" Text="{Binding CompactWidth, StringFormat='{}{0:0} px'}" />
                            <Slider Style="{StaticResource SettingsSlider}" Minimum="90" Maximum="400" SmallChange="1" LargeChange="10"
                                    TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding CompactWidth}" />
                        </StackPanel>
                    </HeaderedContentControl>
                    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Высота">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource SettingsValueText}" Text="{Binding CompactHeight, StringFormat='{}{0:0} px'}" />
                            <Slider Style="{StaticResource SettingsSlider}" Minimum="24" Maximum="60" SmallChange="1" LargeChange="4"
                                    TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding CompactHeight}" />
                        </StackPanel>
                    </HeaderedContentControl>
                    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Скругление углов" Tag="Половина высоты и больше — идеальная «пилюля»">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource SettingsValueText}" Text="{Binding CornerRadius, StringFormat='{}{0:0} px'}" />
                            <Slider Style="{StaticResource SettingsSlider}" Minimum="0" Maximum="30" SmallChange="1" LargeChange="4"
                                    TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding CornerRadius}" />
                        </StackPanel>
                    </HeaderedContentControl>
                    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Скругление в развёрнутом виде">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource SettingsValueText}" Text="{Binding ExpandedCornerRadius, StringFormat='{}{0:0} px'}" />
                            <Slider Style="{StaticResource SettingsSlider}" Minimum="8" Maximum="48" SmallChange="1" LargeChange="4"
                                    TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding ExpandedCornerRadius}" />
                        </StackPanel>
                    </HeaderedContentControl>
                    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Непрозрачность">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource SettingsValueText}" Text="{Binding CapsuleOpacity, StringFormat='{}{0:P0}'}" />
                            <Slider Style="{StaticResource SettingsSlider}" Minimum="0.5" Maximum="1" SmallChange="0.01" LargeChange="0.05"
                                    TickFrequency="0.01" IsSnapToTickEnabled="True" Value="{Binding CapsuleOpacity}" />
                        </StackPanel>
                    </HeaderedContentControl>

                    <TextBlock Style="{StaticResource SettingsSectionHeader}" Text="Стиль" />
                    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Цветовая схема" Tag="«Адаптивный» подкрашивает остров цветом обложки">
                        <ComboBox Style="{StaticResource SettingsComboBox}"
                                  ItemsSource="{Binding ColorSchemeOptions}"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding ColorScheme}" />
                    </HeaderedContentControl>
                    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Скорость анимаций">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource SettingsValueText}" Text="{Binding AnimationSpeed, StringFormat='{}{0:0.0#}×'}" />
                            <Slider Style="{StaticResource SettingsSlider}" Minimum="0.5" Maximum="2" SmallChange="0.05" LargeChange="0.25"
                                    TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding AnimationSpeed}" />
                        </StackPanel>
                    </HeaderedContentControl>

                    <TextBlock Style="{StaticResource SettingsSectionHeader}" Text="Расположение" />
                    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Положение по горизонтали">
                        <ComboBox Style="{StaticResource SettingsComboBox}"
                                  ItemsSource="{Binding PositionOptions}"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding HorizontalPosition}" />
                    </HeaderedContentControl>
                    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Отступ сверху">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource SettingsValueText}" Text="{Binding TopOffset, StringFormat='{}{0:0} px'}" />
                            <Slider Style="{StaticResource SettingsSlider}" Minimum="0" Maximum="100" SmallChange="1" LargeChange="5"
                                    TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding TopOffset}" />
                        </StackPanel>
                    </HeaderedContentControl>
                    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Смещение по горизонтали" Tag="Отрицательные значения — влево">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource SettingsValueText}" Text="{Binding HorizontalOffset, StringFormat='{}{0:0} px'}" />
                            <Slider Style="{StaticResource SettingsSlider}" Minimum="-600" Maximum="600" SmallChange="1" LargeChange="20"
                                    TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding HorizontalOffset}" />
                        </StackPanel>
                    </HeaderedContentControl>

                    <TextBlock Style="{StaticResource SettingsSectionHeader}" Text="Поведение" />
                    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Показывать в простое" Tag="Маленькая капсула видна, даже когда ничего не происходит">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowWhenIdle}" />
                    </HeaderedContentControl>
                    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Раскрывать при наведении" Tag="Помимо щелчка — после короткой задержки">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ExpandOnHover}" />
                    </HeaderedContentControl>
                    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Пульсация под бит"
                                            Tag="Низ раскрытого острова подпрыгивает в такт музыке и видео (нужен включённый визуализатор)">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding PulseToBeat}" />
                    </HeaderedContentControl>
                </StackPanel>
            </ScrollViewer>

            <!-- ─────────── Функции ─────────── -->
            <ScrollViewer x:Name="PageFeatures" VerticalScrollBarVisibility="Auto" Focusable="False" Visibility="Collapsed">
                <StackPanel Margin="24,20,28,28">
                    <TextBlock Style="{StaticResource SettingsPageTitle}" Text="Функции" />

                    <TextBlock Style="{StaticResource SettingsSectionHeader}" Text="Уведомления" Margin="2,0,0,8" />
                    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Показывать уведомления Windows" Tag="Нужен доступ к уведомлениям (Параметры → Конфиденциальность)">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding NotificationsEnabled}" />
                    </HeaderedContentControl>
                    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Длительность показа" IsEnabled="{Binding NotificationsEnabled}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource SettingsValueText}" Text="{Binding NotificationDuration, StringFormat='{}{0:0.#} с'}" />
                            <Slider Style="{StaticResource SettingsSlider}" Minimum="2" Maximum="30" SmallChange="0.5" LargeChange="2"
                                    TickFrequency="0.5" IsSnapToTickEnabled="True" Value="{Binding NotificationDuration}" />
                        </StackPanel>
                    </HeaderedContentControl>

                    <TextBlock Style="{StaticResource SettingsSectionHeader}" Text="Медиа" />
                    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Музыка" Tag="Обложка, исполнитель и управление воспроизведением">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding MusicMode}" />
                    </HeaderedContentControl>
                    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Видео" Tag="Браузеры и видеоплееры">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding VideoMode}" />
                    </HeaderedContentControl>
                    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Текст песни"
                                            Tag="Синхронизированный текст в раскрытом острове. Название и исполнитель трека отправляются на lrclib.net"
                                            IsEnabled="{Binding MusicMode}">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding LyricsEnabled}" />
                    </HeaderedContentControl>

                    <TextBlock Style="{StaticResource SettingsSectionHeader}" Text="Визуализатор звука" />
                    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Визуализатор" Tag="Анализирует звук, который воспроизводит компьютер">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding VisualizerEnabled}" />
                    </HeaderedContentControl>
                    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Стиль" IsEnabled="{Binding VisualizerEnabled}">
                        <ComboBox Style="{StaticResource SettingsComboBox}"
                                  ItemsSource="{Binding VisualizerStyleOptions}"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding VisualizerStyle}" />
                    </HeaderedContentControl>
                    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Источник звука"
                                            Tag="Авто следует за устройством, на котором сейчас звучит музыка"
                                            IsEnabled="{Binding VisualizerEnabled}">
                        <StackPanel Orientation="Horizontal">
                            <ComboBox Style="{StaticResource SettingsComboBox}" MinWidth="240" MaxWidth="320"
                                      ItemsSource="{Binding AudioDeviceOptions}"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding VisualizerDeviceId}" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE72C;" Margin="8,0,0,0"
                                    ToolTip="Обновить список устройств" Click="RefreshAudioDevices_Click" />
                        </StackPanel>
                    </HeaderedContentControl>
                    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Чувствительность" IsEnabled="{Binding VisualizerEnabled}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource SettingsValueText}" Text="{Binding VisualizerSensitivity, StringFormat='{}{0:0.0#}×'}" />
                            <Slider Style="{StaticResource SettingsSlider}" Minimum="0.5" Maximum="2" SmallChange="0.05" LargeChange="0.25"
                                    TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding VisualizerSensitivity}" />
                        </StackPanel>
                    </HeaderedContentControl>

                    <TextBlock Style="{StaticResource SettingsSectionHeader}" Text="Загрузки" />
                    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Отслеживать загрузки" Tag="Прогресс скачивания файлов в острове">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding DownloadsEnabled}" />
                    </HeaderedContentControl>
                    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Папка загрузок" Tag="{Binding DownloadsFolderDisplay}" IsEnabled="{Binding DownloadsEnabled}">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource SecondaryButton}" Content="По умолчанию" Margin="0,0,8,0"
                                    Click="ResetDownloadsFolder_Click"
                                    Visibility="{Binding HasCustomDownloadsFolder, Converter={StaticResource BoolToVisibility}}" />
                            <Button Style="{StaticResource SecondaryButton}" Content="Обзор…" Click="BrowseDownloads_Click" />
                        </StackPanel>
                    </HeaderedContentControl>
                </StackPanel>
            </ScrollViewer>

            <!-- ─────────── Индикаторы ─────────── -->
            <ScrollViewer x:Name="PageIndicators" VerticalScrollBarVisibility="Auto" Focusable="False" Visibility="Collapsed">
                <StackPanel Margin="24,20,28,28">
                    <TextBlock Style="{StaticResource SettingsPageTitle}" Text="Индикаторы" />

                    <TextBlock Style="{StaticResource SettingsSectionHeader}" Text="Показывать в острове" Margin="2,0,0,8" />
                    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Громкость">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IndicatorVolume}" />
                    </HeaderedContentControl>
                    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Яркость" Tag="Только для встроенных дисплеев ноутбуков">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IndicatorBrightness}" />
                    </HeaderedContentControl>
                    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Батарея" Tag="Предупреждение о низком заряде">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IndicatorBattery}" />
                    </HeaderedContentControl>
                    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Зарядное устройство" Tag="Подключение и отключение питания">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IndicatorCharger}" />
                    </HeaderedContentControl>
                    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="USB-устройства">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IndicatorUsb}" />
                    </HeaderedContentControl>
                    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Bluetooth">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IndicatorBluetooth}" />
                    </HeaderedContentControl>
                    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Микрофон" Tag="Включение и выключение звука микрофона">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IndicatorMicrophone}" />
                    </HeaderedContentControl>

                    <TextBlock Style="{StaticResource SettingsSectionHeader}" Text="Параметры" />
                    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Длительность показа индикатора">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource SettingsValueText}" Text="{Binding HudDuration, StringFormat='{}{0:0.0} с'}" />
                            <Slider Style="{StaticResource SettingsSlider}" Minimum="0.8" Maximum="10" SmallChange="0.1" LargeChange="0.5"
                                    TickFrequency="0.1" IsSnapToTickEnabled="True" Value="{Binding HudDuration}" />
                        </StackPanel>
                    </HeaderedContentControl>
                    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Порог низкого заряда" Tag="Ниже этого уровня остров предупредит о разряде" IsEnabled="{Binding IndicatorBattery}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource SettingsValueText}" Text="{Binding LowBatteryThreshold, StringFormat='{}{0:P0}'}" />
                            <Slider Style="{StaticResource SettingsSlider}" Minimum="0.05" Maximum="0.5" SmallChange="0.01" LargeChange="0.05"
                                    TickFrequency="0.01" IsSnapToTickEnabled="True" Value="{Binding LowBatteryThreshold}" />
                        </StackPanel>
                    </HeaderedContentControl>
                </StackPanel>
            </ScrollViewer>

            <!-- ─────────── Таймер ─────────── -->
            <ScrollViewer x:Name="PageTimer" VerticalScrollBarVisibility="Auto" Focusable="False" Visibility="Collapsed">
                <StackPanel Margin="24,20,28,28">
                    <TextBlock Style="{StaticResource SettingsPageTitle}" Text="Таймер" />

                    <Border Style="{StaticResource SettingsCard}" Padding="18,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource SettingsIconText}" Text="&#xE916;" FontSize="{StaticResource IconSizeLarge}" />
                                <TextBlock Text="{Binding TimerStatusText}" Margin="12,0,0,0" VerticalAlignment="Center"
                                           FontFamily="{StaticResource DisplayFont}" FontSize="{StaticResource FontSizeLarge}"
                                           FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            </StackPanel>
                            <WrapPanel Margin="0,16,0,0">
                                <Button Style="{StaticResource PrimaryButton}" Content="Запустить таймер" Margin="0,0,8,8"
                                        Command="{Binding StartTimerCommand}" ToolTip="Обратный отсчёт с длительностью по умолчанию" />
                                <Button Style="{StaticResource SecondaryButton}" Content="Секундомер" Margin="0,0,8,8"
                                        Command="{Binding StartStopwatchCommand}" />
                                <Button Style="{StaticResource SecondaryButton}" Content="{Binding PauseButtonText}" Margin="0,0,8,8"
                                        Command="{Binding TogglePauseCommand}"
                                        Visibility="{Binding IsTimerActive, Converter={StaticResource BoolToVisibility}}" />
                                <Button Style="{StaticResource SecondaryButton}" Content="+1 мин" Margin="0,0,8,8"
                                        Command="{Binding ExtendTimerCommand}"
                                        Visibility="{Binding IsCountdownActive, Converter={StaticResource BoolToVisibility}}" />
                                <Button Style="{StaticResource DangerButton}" Content="Стоп" Margin="0,0,8,8"
                                        Command="{Binding StopTimerCommand}" />
                            </WrapPanel>
                            <TextBlock Style="{StaticResource SettingsCaptionText}" Text="Быстрый запуск" Margin="0,8,0,8" />
                            <ItemsControl ItemsSource="{Binding Presets}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" MinWidth="72"
                                                Content="{Binding}" ContentStringFormat="{}{0:0.##} мин"
                                                Command="{Binding DataContext.StartPresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SettingsSectionHeader}" Text="Параметры" />
                    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Длительность по умолчанию" Tag="Для кнопки «Запустить таймер» и горячих клавиш">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource SettingsValueText}" Text="{Binding DefaultCountdownMinutes, StringFormat='{}{0:0} мин'}" />
                            <Slider Style="{StaticResource SettingsSlider}" Minimum="1" Maximum="120" SmallChange="1" LargeChange="5"
                                    TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding DefaultCountdownMinutes}" />
                        </StackPanel>
                    </HeaderedContentControl>
                    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Пресеты (минуты)" Tag="Через запятую, не больше 8. Например: 1, 3, 5, 10, 25">
                        <TextBox x:Name="PresetsBox" Style="{StaticResource SettingsTextBox}" Width="220"
                                 Text="{Binding PresetsText, UpdateSourceTrigger=LostFocus}"
                                 KeyDown="PresetsBox_KeyDown" />
                    </HeaderedContentControl>
                    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Звук по окончании">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding TimerSound}" />
                    </HeaderedContentControl>
                    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Уведомление по окончании">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding TimerNotify}" />
                    </HeaderedContentControl>
                </StackPanel>
            </ScrollViewer>

            <!-- ─────────── Система ─────────── -->
            <ScrollViewer x:Name="PageSystem" VerticalScrollBarVisibility="Auto" Focusable="False" Visibility="Collapsed">
                <StackPanel Margin="24,20,28,28">
                    <TextBlock Style="{StaticResource SettingsPageTitle}" Text="Система" />

                    <TextBlock Style="{StaticResource SettingsSectionHeader}" Text="Запуск" Margin="2,0,0,8" />
                    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Запускать вместе с Windows">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding LaunchAtStartup}" />
                    </HeaderedContentControl>
                    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Запускать в фоне" Tag="Не открывать это окно при запуске">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding StartInBackground}" />
                    </HeaderedContentControl>

                    <TextBlock Style="{StaticResource SettingsSectionHeader}" Text="Отображение" />
                    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Монитор" Tag="На каком экране показывать остров">
                        <StackPanel Orientation="Horizontal">
                            <ComboBox Style="{StaticResource SettingsComboBox}" MinWidth="240"
                                      ItemsSource="{Binding MonitorOptions}"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding MonitorDeviceName}" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE72C;" Margin="8,0,0,0"
                                    ToolTip="Обновить список мониторов" Click="RefreshMonitors_Click" />
                        </StackPanel>
                    </HeaderedContentControl>
                    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Скрывать в полноэкранном режиме" Tag="Игры, видео и презентации на весь экран">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding HideInFullscreen}" />
                    </HeaderedContentControl>
                    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Значок в области уведомлений">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowTrayIcon}" />
                    </HeaderedContentControl>

                    <TextBlock Style="{StaticResource SettingsSectionHeader}" Text="Горячие клавиши" />
                    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Глобальные сочетания клавиш"
                                            Tag="Щёлкните поле и нажмите сочетание. Esc или Backspace — очистить">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding HotkeysEnabled}" />
                    </HeaderedContentControl>
                    <ItemsControl ItemsSource="{Binding Hotkeys}" IsEnabled="{Binding HotkeysEnabled}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <HeaderedContentControl Style="{StaticResource SettingRow}" Header="{Binding Label}" Tag="{Binding Error}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox Style="{StaticResource HotkeyBox}"
                                                 Text="{Binding DisplayText, Mode=OneWay}"
                                                 PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                                                 PreviewKeyUp="HotkeyBox_PreviewKeyUp"
                                                 GotKeyboardFocus="HotkeyBox_GotKeyboardFocus"
                                                 LostKeyboardFocus="HotkeyBox_LostKeyboardFocus" />
                                        <Button Style="{StaticResource IconButton}" Content="&#xE711;" Margin="8,0,0,0"
                                                ToolTip="Очистить" Click="ClearHotkey_Click" />
                                    </StackPanel>
                                </HeaderedContentControl>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Style="{StaticResource SettingsSectionHeader}" Text="Обслуживание" />
                    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Сбросить настройки" Tag="Вернуть все параметры к значениям по умолчанию">
                        <Button Style="{StaticResource DangerButton}" Content="Сбросить…" Click="ResetSettings_Click" />
                    </HeaderedContentControl>
                    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Журнал работы" Tag="Пригодится при поиске проблем">
                        <Button Style="{StaticResource SecondaryButton}" Content="Открыть папку логов" Click="OpenLogs_Click" />
                    </HeaderedContentControl>
                    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Завершить работу" Tag="Остров исчезнет до следующего запуска">
                        <Button Style="{StaticResource DangerButton}" Content="Выйти из приложения" Click="Exit_Click" />
                    </HeaderedContentControl>
                </StackPanel>
            </ScrollViewer>

            <!-- ─────────── Диагностика ─────────── -->
            <ScrollViewer x:Name="PageDiagnostics" VerticalScrollBarVisibility="Auto" Focusable="False" Visibility="Collapsed">
                <StackPanel Margin="24,20,28,28">
                    <TextBlock Style="{StaticResource SettingsPageTitle}" Text="Диагностика" />

                    <TextBlock Style="{StaticResource SettingsSectionHeader}" Text="Модули" Margin="2,0,0,8" />
                    <TextBlock Style="{StaticResource SettingsCaptionText}" Margin="2,0,0,8"
                               Text="Модули ещё не сообщили о своём состоянии."
                               Visibility="{Binding NoStatuses, Converter={StaticResource BoolToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding Statuses}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource SettingsCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="190" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse x:Name="Dot" Grid.Column="0" Width="9" Height="9" Margin="0,0,12,0"
                                                 VerticalAlignment="Center" Fill="{StaticResource AccentGreenBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource SettingsBodyText}"
                                                   FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding Message}" Style="{StaticResource SettingsCaptionText}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsWorking}" Value="False">
                                        <Setter TargetName="Dot" Property="Fill" Value="{StaticResource AccentRedBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Style="{StaticResource SettingsSectionHeader}" Text="Сведения" />
                    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Версия приложения">
                        <TextBlock Style="{StaticResource SettingsBodyText}" Text="{Binding AppVersion}" />
                    </HeaderedContentControl>
                    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Файл настроек" Tag="{Binding SettingsFilePath}">
                        <Button Style="{StaticResource SecondaryButton}" Content="Открыть папку" Click="OpenSettingsFolder_Click" />
                    </HeaderedContentControl>
                    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Папка логов" Tag="{Binding LogsFolder}">
                        <Button Style="{StaticResource SecondaryButton}" Content="Открыть папку" Click="OpenLogs_Click" />
                    </HeaderedContentControl>
                    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Среда выполнения" Tag="{Binding RuntimeDescription}" />
                </StackPanel>
            </ScrollViewer>

            <!-- ─────────── О программе ─────────── -->
            <ScrollViewer x:Name="PageAbout" VerticalScrollBarVisibility="Auto" Focusable="False" Visibility="Collapsed">
                <StackPanel Margin="24,20,28,28">
                    <TextBlock Style="{StaticResource SettingsPageTitle}" Text="О программе" />
                    <Border Style="{StaticResource SettingsCard}" Padding="24,22">
                        <StackPanel>
                            <Border Width="150" Height="40" CornerRadius="20" Background="Black" HorizontalAlignment="Left"
                                    BorderBrush="{StaticResource SettingsControlBorderBrush}" BorderThickness="1">
                                <Grid Margin="14,0">
                                    <Ellipse Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Ellipse.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#FF0A84FF" Offset="0" />
                                                <GradientStop Color="#FFBF5AF2" Offset="1" />
                                            </LinearGradientBrush>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <Ellipse Width="7" Height="7" Fill="{StaticResource AccentGreenBrush}"
                                             HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <TextBlock Text="Windows Dynamic Island" Margin="0,18,0,0"
                                       FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Style="{StaticResource SettingsCaptionText}" Margin="0,4,0,0">
                                <Run Text="Версия " /><Run Text="{Binding AppVersion, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource SettingsBodyText}" Margin="0,14,0,0" Foreground="{StaticResource TextSecondaryBrush}"
                                       Text="«Живой остров» в верхней части экрана для Windows 10 и 11: музыка и видео, уведомления, таймеры, загрузки и системные индикаторы — в одной аккуратной капсуле." />
                            <TextBlock Style="{StaticResource SettingsCaptionText}" Margin="0,14,0,0"
                                       Text="Щелчок по капсуле — развернуть, правый щелчок — меню. Значок в трее — быстрые действия." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>

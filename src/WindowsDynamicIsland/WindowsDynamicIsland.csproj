<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 19041 TFM gives the WinRT projections (GSMTC, Bluetooth, Notifications) via CsWinRT.
         SupportedOSPlatformVersion keeps Windows 10 1809+ able to run the app. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <!-- WinForms only for Screen enumeration and NotifyIcon. Never add `using System.Windows.Forms;` —
         always fully qualify WinForms types to avoid WPF/WinForms name clashes. -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <!-- Implicit usings are declared explicitly below to keep WinForms/Drawing namespaces out. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <RootNamespace>WindowsDynamicIsland</RootNamespace>
    <AssemblyName>DynamicIsland</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\island.ico</ApplicationIcon>
    <Version>1.3.4</Version>
    <Product>Windows Dynamic Island</Product>
    <Company>Zhd</Company>
    <Authors>Zhd</Authors>
    <Copyright>Copyright © 2026 Zhd</Copyright>
    <Description>Dynamic Island for Windows 10/11</Description>
    <!-- Runs on the newest installed .NET runtime (8, 9, 10…) when .NET 8 itself is not installed. -->
    <RollForward>LatestMajor</RollForward>
    <TieredPGO>true</TieredPGO>
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>en;ru</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- WFAC010 is a WinForms-only analyzer about manifest DPI; this is a WPF app using PerMonitorV2 via the manifest. -->
    <NoWarn>$(NoWarn);CA1416;WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System" />
    <Using Include="System.Collections.Generic" />
    <Using Include="System.IO" />
    <Using Include="System.Linq" />
    <Using Include="System.Threading" />
    <Using Include="System.Threading.Tasks" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\island.ico" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WindowsDynamicIsland.Tests" />
  </ItemGroup>

</Project>
